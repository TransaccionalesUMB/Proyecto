package com.example.transactional.service;

import com.example.transactional.dto.ProductDto;
import com.example.transactional.model.Product;
import com.example.transactional.model.Stock;
import com.example.transactional.repository.ProductRepository;
import com.example.transactional.repository.StockRepository;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;
import org.springframework.jdbc.core.JdbcTemplate;

import java.util.ArrayList;
import java.util.List;
import java.util.Optional;

@Service
public class ProductService {

    @Autowired
    private ProductRepository productRepository;
    
    @Autowired
    private StockRepository stockRepository;
    
    @Autowired
    private JdbcTemplate jdbcTemplate;
    
    public List<ProductDto> getAllProductsWithStock() {
        List<Product> products = productRepository.findAll();
        List<ProductDto> productDtos = new ArrayList<>();
        
        for (Product product : products) {
            ProductDto dto = convertToDto(product);
            Integer totalStock = stockRepository.getTotalStockByProductId(product.getId());
            dto.setStock(totalStock != null ? totalStock : 0);
            productDtos.add(dto);
        }
        
        return productDtos;
    }
    
    /**
     * Obtiene todos los productos sin información de stock
     * @return Lista de productos
     */
    public List<Product> getAllProducts() {
        return productRepository.findAll();
    }
    
    @Transactional
    public Product saveProductWithStock(ProductDto productDto) {
        // Verificar y crear la categoría si no existe
        ensureCategoryExists(productDto.getCategoryId());
        
        // Verificar y crear el proveedor si no existe
        ensureProviderExists(productDto.getProviderId());
        
        // Guardar el producto
        Product product = new Product();
        product.setName(productDto.getName());
        product.setDescription(productDto.getDescription());
        product.setPrice(productDto.getPrice());
        product.setCategoryId(productDto.getCategoryId());
        product.setProviderId(productDto.getProviderId());
        
        Product savedProduct = productRepository.save(product);
        
        // Si se especifica stock, crear un registro en la tabla Stock
        if (productDto.getStock() != null && productDto.getStock() > 0) {
            // Asegurarse de que la bodega con ID 1 existe
            ensureWarehouseExists("1");
            
            Stock stock = new Stock();
            stock.setIdProducto(savedProduct.getId());
            stock.setNombreProducto(savedProduct.getName());
            stock.setCantidad(productDto.getStock());
            stock.setIdBodega(1); // Valor predeterminado
            
            stockRepository.save(stock);
        }
        
        return savedProduct;
    }
    
    // Método para verificar y crear la categoría si no existe
    private void ensureCategoryExists(String categoryId) {
        if (categoryId == null || categoryId.trim().isEmpty()) {
            return;
        }
        
        // Verificar si la categoría existe
        Integer count = jdbcTemplate.queryForObject(
            "SELECT COUNT(*) FROM Categoria WHERE id_categoria = ?", 
            Integer.class, 
            categoryId
        );
        
        // Si no existe, crearla
        if (count == null || count == 0) {
            jdbcTemplate.update(
                "INSERT INTO Categoria (id_categoria, nombre) VALUES (?, ?)",
                categoryId,
                "Categoría " + categoryId
            );
        }
    }
    
    // Método para verificar y crear el proveedor si no existe
    private void ensureProviderExists(String providerId) {
        if (providerId == null || providerId.trim().isEmpty()) {
            return;
        }
        
        // Verificar si el proveedor existe
        Integer count = jdbcTemplate.queryForObject(
            "SELECT COUNT(*) FROM Proveedor WHERE id_proveedor = ?", 
            Integer.class, 
            providerId
        );
        
        // Si no existe, crearlo
        if (count == null || count == 0) {
            jdbcTemplate.update(
                "INSERT INTO Proveedor (id_proveedor, nombre, contacto) VALUES (?, ?, ?)",
                providerId,
                "Proveedor " + providerId,
                "Sin contacto"
            );
        }
    }
    
    // Método para verificar y crear la bodega si no existe
    private void ensureWarehouseExists(Integer warehouseId) {
        if (warehouseId == null) {
            return;
        }
        ensureWarehouseExistsInternal(warehouseId);
    }
    
    // Método para verificar y crear la bodega si no existe (versión String)
    private void ensureWarehouseExists(String warehouseId) {
        if (warehouseId == null || warehouseId.trim().isEmpty()) {
            return;
        }
        try {
            ensureWarehouseExistsInternal(Integer.parseInt(warehouseId));
        } catch (NumberFormatException e) {
            // Si no es un número válido, no hacemos nada
        }
    }
    
    // Método interno para verificar y crear la bodega
    private void ensureWarehouseExistsInternal(Integer warehouseId) {
        
        // Verificar si la bodega existe
        Integer count = jdbcTemplate.queryForObject(
            "SELECT COUNT(*) FROM Bodega WHERE id_bodega = ?", 
            Integer.class, 
            warehouseId
        );
        
        // Si no existe, crearla
        if (count == null || count == 0) {
            jdbcTemplate.update(
                "INSERT INTO Bodega (id_bodega, nombre) VALUES (?, ?)",
                warehouseId,
                "Bodega " + warehouseId
            );
        }
    }
    
    public Optional<ProductDto> getProductById(Integer id) {
        Optional<Product> productOpt = productRepository.findById(id);
        if (productOpt.isPresent()) {
            ProductDto dto = convertToDto(productOpt.get());
            Integer totalStock = stockRepository.getTotalStockByProductId(id);
            dto.setStock(totalStock != null ? totalStock : 0);
            return Optional.of(dto);
        }
        return Optional.empty();
    }
    
    public Optional<ProductDto> getProductById(String id) {
        try {
            return getProductById(Integer.parseInt(id));
        } catch (NumberFormatException e) {
            return Optional.empty();
        }
    }
    
    /**
     * Obtiene un producto por su ID
     * @param id ID del producto
     * @return Producto o vacío si no existe
     */
    public Optional<Product> getProductEntityById(Integer id) {
        return productRepository.findById(id);
    }
    
    /**
     * Obtiene un producto por su ID (String)
     * @param id ID del producto como String
     * @return Producto o vacío si no existe
     */
    public Optional<Product> getProductEntityById(String id) {
        try {
            return getProductEntityById(Integer.parseInt(id));
        } catch (NumberFormatException e) {
            return Optional.empty();
        }
    }
    
    @Transactional
    public Product updateProduct(ProductDto productDto) {
        // Verificar y crear la categoría si no existe
        ensureCategoryExists(productDto.getCategoryId());
        
        // Verificar y crear el proveedor si no existe
        ensureProviderExists(productDto.getProviderId());
        
        // Buscar y actualizar el producto existente
        Optional<Product> existingProductOpt = productRepository.findById(productDto.getId());
        if (existingProductOpt.isEmpty()) {
            throw new RuntimeException("Producto no encontrado con ID: " + productDto.getId());
        }
        
        Product existingProduct = existingProductOpt.get();
        existingProduct.setName(productDto.getName());
        existingProduct.setDescription(productDto.getDescription());
        existingProduct.setPrice(productDto.getPrice());
        existingProduct.setCategoryId(productDto.getCategoryId());
        existingProduct.setProviderId(productDto.getProviderId());
        
        Product updatedProduct = productRepository.save(existingProduct);
        
        // Actualizar stock si ha cambiado
        Integer currentStock = stockRepository.getTotalStockByProductId(updatedProduct.getId());
        Integer newStock = productDto.getStock();
        
        if (newStock != null && (currentStock == null || !newStock.equals(currentStock))) {
            // Asegurarse de que la bodega con ID 1 existe
            ensureWarehouseExists("1");
            
            List<Stock> stocks = stockRepository.findByProductId(updatedProduct.getId());
            
            if (stocks.isEmpty()) {
                // No hay registros de stock, crear uno nuevo si el stock es mayor que cero
                if (newStock > 0) {
                    Stock stock = new Stock();
                    stock.setIdProducto(updatedProduct.getId());
                    stock.setNombreProducto(updatedProduct.getName());
                    stock.setCantidad(newStock);
                    stock.setIdBodega(1); // Valor predeterminado
                    stockRepository.save(stock);
                }
            } else {
                // Actualizar el stock existente (primer registro)
                Stock stock = stocks.get(0);
                stock.setNombreProducto(updatedProduct.getName());
                stock.setCantidad(newStock);
                stockRepository.save(stock);
                
                // Si hay múltiples registros de stock, eliminar los adicionales para mantener consistencia
                if (stocks.size() > 1) {
                    for (int i = 1; i < stocks.size(); i++) {
                        stockRepository.delete(stocks.get(i));
                    }
                }
            }
        }
        
        return updatedProduct;
    }
    
    private ProductDto convertToDto(Product product) {
        ProductDto dto = new ProductDto();
        dto.setId(product.getId());
        dto.setName(product.getName());
        dto.setDescription(product.getDescription());
        dto.setPrice(product.getPrice());
        dto.setCategoryId(product.getCategoryId());
        dto.setProviderId(product.getProviderId());
        return dto;
    }
}
